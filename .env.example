# Scheduler
TIMEZONE=Asia/Kolkata
DAILY_RUN_TIME=06:00

# Database is OPTIONAL. Leave blank until you choose a datastore.
DATABASE_URL=

# OpenAI / ChatGPT prompt writer
OPENAI_API_KEY=
OPENAI_PROMPT_MODEL=gpt-5.6-luna

# Google Gemini / Veo (video generation stage; optional until enabled)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# Instagram Graph API (official API only)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v23.0

# Meesho provider adapter
# Keep disabled until an officially permitted product API/feed/export is connected.
MEESHO_PROVIDER_ENABLED=false
MEESHO_PRODUCT_FEED_URL=

# Content defaults
TARGET_LANGUAGE=Hindi
REEL_ASPECT_RATIO=9:16
MAX_VIDEO_SECONDS=10
MIN_PRICE_INR=199
MAX_PRICE_INR=999
MIN_COMMISSION_PERCENT=5
