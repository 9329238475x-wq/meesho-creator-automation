# Scheduler
TIMEZONE=Asia/Kolkata
DAILY_RUN_TIME=06:00

# Database
DATABASE_URL=sqlite:///data/meesho_automation.db

# Google Gemini API (optional in Phase 1)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# Instagram Graph API (official API only)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Meesho provider adapter
# Leave disabled until an officially permitted API/export/feed is available.
MEESHO_PROVIDER_ENABLED=false
MEESHO_PRODUCT_FEED_URL=

# Content defaults
TARGET_LANGUAGE=Hindi
REEL_ASPECT_RATIO=9:16
MAX_VIDEO_SECONDS=10
MIN_PRICE_INR=199
MAX_PRICE_INR=999
MIN_COMMISSION_PERCENT=5
